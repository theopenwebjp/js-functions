{
    "name": "@theopenweb/js-functions",
    "type": "module",
    "version": "2.1.0",
    "description": "Set of general/common utility functions that can be used in JavaScript. Uses es6 exports.",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "directories": {
        "test": "tests"
    },
    "files": [
        "dist",
        "package.json",
        "LICENSE",
        "readme.md"
    ],
    "scripts": {
        "test": "npm run test-treeshaking && npm run test-nyc",
        "docs": "npm run api-docs && npm run eslint",
        "test-treeshaking": "cd ./test/tests/tree-shaking && webpack --config ./webpack.config.cjs",
        "test-nyc": "nyc --reporter=html mocha ./test/tests/browser/tests/*.js --require esm -r jsdom-global/register",
        "api-docs": "typedoc --plugin typedoc-plugin-markdown --out api_docs --options typedoc/typedoc.json",
        "eslint": "eslint --config .eslintrc \"./src/**/*.js\" --format html --output-file report-results.html",
        "ts-lint": "tsc --noEmit",
        "clean": "npx rimraf dist",
        "build": "npm run clean && tsc",
        "pre-commit": "npm run test && npm run docs && npm run build"
    },
    "devDependencies": {
        "@types/chai": "^5.2.2",
        "@types/jsdom": "^21.1.7",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.3.0",
        "chai": "^6.0.1",
        "eslint": "^9.34.0",
        "eslint-html-reporter": "^0.7.4",
        "esm": "^3.2.25",
        "hamburgers": "^1.2.1",
        "jquery": "^3.7.1",
        "jsdom": "26.1.0",
        "jsdom-global": "3.0.2",
        "jsuri": "^1.3.1",
        "mocha": "^11.7.1",
        "nyc": "^17.1.0",
        "rimraf": "^6.1.3",
        "typedoc": "^0.28.11",
        "typedoc-plugin-markdown": "^4.8.1",
        "typescript": "^5.9.2",
        "webpack": "^5.101.3",
        "webpack-cli": "^6.0.1"
    },
    "keywords": [
        "functions",
        "utility",
        "es6",
        "library"
    ],
    "author": "The Open Web <noreply@theopenweb.jp> (https://theopenweb.jp)",
    "contributors": [
        "Damien Golding <noreply@damiengolding.com> (https://damiengolding.com)"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/theopenwebjp/js-functions.git"
    },
    "homepage": "https://theopenweb.info",
    "bugs": {
        "url": "https://github.com/theopenwebjp/js-functions/issues"
    },
    "private": false,
    "license": "MIT",
    "sideEffects": false
}
